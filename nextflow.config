// ----------------- Caps -----------------
params {
  max_memory = 330.GB
  max_cpus   = 48
  max_time   = 7.d
}

// ----------------- Singularity/Apptainer -----------------
singularity {
  enabled    = true
  autoMounts = true
  cacheDir   = "/fs04/scratch2/vh83/liem/projects/molbi_pipeline/containers"
  runOptions = '-B /scratch -B /projects -B /fs04'
}

// ----------------- Slurm executor tuning -----------------
executor {
  queueSize         = 200
  pollInterval      = '30 sec'
  queueStatInterval = '10m'
}

// ----------------- Process defaults -----------------
process {
  executor      = 'slurm'
  stageInMode   = 'symlink'
  cache         = 'lenient'
  beforeScript  = 'module load singularity'
  errorStrategy = 'retry'
  maxRetries    = 3
  scratch       = true

  // DEFAULT resources (non-heavy hitters)
  cpus   = { 2 }
  memory = { [ (task.attempt == 1) ? 8.GB  : (8.GB  + (task.attempt * 4.GB)),   params.max_memory ].min() }
  time   = { [ (task.attempt == 1) ? 1.h   : (1.h   + (task.attempt * 0.5.h)),  params.max_time   ].min() }

  // Dynamic partition/QoS selection
  clusterOptions = { task.time <= 4.h ? '--partition=genomics --qos=genomics' : '--partition=comp --qos=normal' }

  // ---- Heavy hitters ----
  withName: /^(ALIGN_AND_SORT|VARDICT.*|CNVKIT|MSIPRO.*|POLYSOLVER)$/ {
    cpus   = { 8 }
    memory = { [ (task.attempt == 1) ? 16.GB : (16.GB + (task.attempt * 8.GB)),  params.max_memory ].min() }
    time   = { [ (task.attempt == 1) ? 2.h   : (2.h   + (task.attempt * 1.h)),   params.max_time   ].min() }
  }
}
